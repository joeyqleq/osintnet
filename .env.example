OSINTNET_ORIGINS=http://127.0.0.1:8780,http://localhost:8780
OSINTNET_WEB_HOSTS=example.org
OSINTNET_INSTANCE=OSINTNET
# Base deployment only; compose.workers.yaml sets gateway workers to zero.
OSINTNET_WORKERS=2
# Explicit approved provider choice; no automatic failover.
OSINTNET_OVERPASS_HOST=overpass.private.coffee
# Set both values before external deployment. Use the actual Access app audience.
OSINTNET_ACCESS_ISSUER=
OSINTNET_ACCESS_AUD=
# Core does not send traces or call these paid providers. Pending integrations only.
COURTLISTENER_TOKEN=
SHODAN_TOKEN=
LANGSMITH_API_KEY=
